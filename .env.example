# ============ CHẾ ĐỘ ============
# paper = chạy ảo (chỉ cần dữ liệu public, KHÔNG cần API key OKX)
# live  = giao dịch thật (cần API key + I_UNDERSTAND_THE_RISK=yes)
MODE=paper
PAPER_START_BALANCE=10
I_UNDERSTAND_THE_RISK=no
# Xoá TOÀN BỘ dữ liệu (vốn ảo, lệnh, tín hiệu, tham số tự học, nhật ký – cả DB dùng chung nếu có DATABASE_URL) MỘT LẦN
# khi khởi động. Cùng giá trị thì lần sau không xoá; đổi giá trị để xoá lần nữa. Chạy thật còn lệnh mở thì không xoá.
RESET_DATA=

# ============ OKX ============
# Tạo tại: OKX > Profile > API > Create API key. Quyền: Trade. KHÔNG bật Withdraw.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# true = dùng tài khoản Demo Trading của OKX (key demo riêng) để test đặt lệnh thật trên sàn ảo
OKX_DEMO=false

# ============ RỦI RO ============
LEVERAGE=10
# Rủi ro cơ bản 3%/lệnh × hệ số tin tức (cùng/ngược chiều × trọng số tin: 0.5–1.5×), co lại sau chuỗi thua, kẹp 0.35–1.5×
RISK_PER_TRADE=0.03
RISK_MAX_MULT=1.5
RISK_MIN_MULT=0.35
LOSS_STREAK_CUT=0.7
# v3.2: co rủi ro từ lệnh thua liên tiếp thứ 3 (trước: thứ 2)
LOSS_STREAK_FROM=3
MAX_OPEN_POSITIONS=2
# Tổng % vốn có thể mất nếu mọi lệnh đang mở cùng chạm SL
MAX_TOTAL_RISK=0.05
# Lot tối thiểu của sàn làm rủi ro thật vượt 2× dự tính → bỏ tín hiệu (vốn nhỏ)
MIN_LOT_RISK_MULT=2.0
MAX_DAILY_LOSS=0.12
MAX_DRAWDOWN=0.30
MIN_RR=1.5
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
TRAIL_ACTIVATE_R=1.2
MAX_HOLD_HOURS=12

# ============ QUÉT COIN ============
# Để trống = dùng danh sách mặc định (BTC, ETH, stablecoin, token hoá cổ phiếu/vàng/dầu...). Ghi đè nếu muốn.
#EXCLUDE=BTC,ETH,USDC,USDT
TIMEFRAME=15m
HTF_TIMEFRAME=1h
SCAN_INTERVAL=300
MONITOR_INTERVAL=20
MIN_SCORE=5.0
# Cổng bắt buộc của tín hiệu (xem README)
MIN_ADX=20
HTF_MIN_ADX=18
MIN_ATR_PCT=0.35
MIN_VOL_RATIO=0.7
MAX_EXT_ATR=1.0
# SL theo cấu trúc xa hơn MAX_SL_ATR → bỏ tín hiệu (không kéo SL vào giữa râu nến)
MAX_SL_ATR=2.5
# Cổng BTC: BTC giảm/tăng quá % này trong 1h thì cấm long/short altcoin (v3.2: 0.3, trước 0.6)
BTC_GATE_CHG=0.3
# v3.2: không đánh ngược nhịp 1h của chính coin (short khi coin vừa tăng ≥ 0.5%/1h hoặc long khi vừa giảm) – 0 = tắt
CHASE_1H_PCT=0.5
# v3.2: volume nến tín hiệu ≥ mức này = cao trào → trừ điểm + luật climax_volume (chặn sẵn, bộ tự học gỡ nếu có lãi)
CLIMAX_VOL=1.5
# ADX 1h ≥ mức này = xu hướng đã chạy lâu. v4.2: KHÔNG trừ điểm nữa (kiểm chứng 89 ngày: nhóm này đảo dấu theo giai đoạn);
# luật late_trend vẫn để bộ tự học chặn khi lỗ rõ. Đặt LATE_TREND_PENALTY=1 để trừ 1 điểm như v3.2.
LATE_TREND_ADX=35
LATE_TREND_PENALTY=0
# Chống bẫy râu: long phải đóng nến >= 60% biên độ (short <= 40%)
WICK_CLOSE_POS=0.6

# ============ QUYẾT ĐỊNH VÀO LỆNH (v4.0: KHÔNG dùng AI – kỹ thuật + tin tức) ============
# Số coin quét; mỗi lượt thử lần lượt tối đa ENTRY_CANDIDATES ứng viên điểm cao nhất, vào được 1 lệnh thì dừng
TOP_N_COINS=50
ENTRY_CANDIDATES=3
# Chỉ quét hợp đồng crypto thường theo phân loại OKX (loại cổ phiếu/hàng hoá token hoá, hợp đồng tiền niêm yết, sắp gỡ)
CRYPTO_ONLY=true
# Luật chặn sẵn (bộ tự học vẫn theo dõi bóng và tự gỡ nếu thực tế có lãi). setup_range = đánh đảo chiều khi đi ngang.
# v4.0: thêm news_delist (coin có tin huỷ niêm yết), news_hack_long (long khi có tin hack), news_listing_short (short khi vừa niêm yết sàn lớn)
DEFAULT_BLOCKS=setup_range,night_session,afternoon_session,climax_volume,news_delist,news_hack_long,news_listing_short
# Tổng kết lệnh (theo số liệu) sau mỗi lệnh đóng
TRADE_REVIEW=true

# ============ LỚP BẢO VỆ (v4.1, kiểu freqtrade) ============
PROTECT_ENABLED=true
# Khoá 1 phía (long/short) PROTECT_LOCK_HOURS giờ khi: ≥ PROTECT_SIDE_LOSSES lệnh thật cùng phía đóng lỗ trong PROTECT_SIDE_HOURS giờ,
# hoặc ≥ PROTECT_SHADOW_MIN coin có tín hiệu cùng phía trong PROTECT_SHADOW_HOURS giờ mà ≥ 80% chạm SL trước khi lời 1R
PROTECT_SIDE_LOSSES=3
PROTECT_SIDE_HOURS=12
PROTECT_SHADOW_MIN=10
PROTECT_SHADOW_SL_SHARE=0.8
PROTECT_SHADOW_HOURS=12
PROTECT_LOCK_HOURS=6
# Coin vừa thua → nghỉ 6h; thua 2 lần trong 24h → nghỉ tới hết 24h
PROTECT_PAIR_LOSS_HOURS=6
PROTECT_PAIR_REPEAT_HOURS=24
# Bỏ hợp đồng niêm yết chưa đủ N ngày (listTime của OKX)
PROTECT_MIN_AGE_DAYS=10

# ============ TIN TỨC (từ điển + luật sự kiện, không AI, không cần API key) ============
NEWS_ENABLED=true
# RSS: tên|url, phân tách dấu phẩy. Để trống = 10 trang tin crypto lớn (CoinDesk, Cointelegraph, The Block, Decrypt...)
#NEWS_FEEDS=CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/,Cointelegraph|https://cointelegraph.com/rss
# Thông báo niêm yết / huỷ niêm yết của OKX + Binance, chỉ số Fear & Greed (alternative.me)
NEWS_ANNOUNCEMENTS=true
NEWS_FNG=true
NEWS_REFRESH_MIN=10
NEWS_TIMEOUT=15
# Điểm tin của coin: bài trong 24h, bài 6h trước nặng bằng nửa bài mới; co về 0 khi ít bài
NEWS_WINDOW_H=24
NEWS_HALF_LIFE_H=6
NEWS_SHRINK=1.0
NEWS_MIN_BIAS=0.15
# Điểm cộng/trừ tối đa = NEWS_SCORE_MAX × trọng số tin (NEWS_WEIGHT; bộ tự học chỉnh 0–2 theo kết quả thật)
NEWS_SCORE_MAX=1.5
NEWS_WEIGHT=1.0
# Lệnh đang mở gặp tin MỚI bất lợi → đóng ngay (long: delist, hack | short: listing). Để trống để tắt.
NEWS_EXIT_EVENTS=delist,hack,listing

# ============ CHẠY SONG SONG RENDER + BOTKEEP (tuỳ chọn) ============
# Postgres dùng chung trên Supabase (free). Trống = SQLite cục bộ, 1 máy.
# Lấy ở Supabase → Connect → Connection string → chọn "Session pooler" (KHÔNG dùng Direct connection, Render không có IPv6)
# Dạng: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Kiểm tra bằng: python check_db.py
DATABASE_URL=
# Tên instance để phân biệt trong log/dashboard (render / botkeep)
INSTANCE_NAME=
# URL public của instance kia, bot ping /health mỗi 4 phút để Render free không ngủ
PEER_URL=
# URL public của chính mình (Render tự cấp RENDER_EXTERNAL_URL nên có thể bỏ trống)
SELF_URL=
# Leader mất liên lạc quá số giây này thì máy kia tiếp quản
LEADER_TTL=90

# ============ TELEGRAM ============
# Tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ============ DASHBOARD ============
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASS=doi-mat-khau-nay

LOG_LEVEL=INFO
# Múi giờ cho log, báo cáo ngày, Telegram
TIMEZONE=Asia/Ho_Chi_Minh

# ============ TỰ HỌC ============
# auto = tự áp dụng thay đổi | suggest = chờ duyệt trên web / Telegram /apply | off = tắt
# Để trống: chạy ảo = auto, chạy thật = suggest
LEARN_MODE=
# Đủ mẫu VÀ khác 0 có ý nghĩa thống kê (|kỳ vọng|/sai số chuẩn ≥ LEARN_MIN_T) mới đổi; mỗi tham số tối đa 1 lần/48h
LEARN_MIN_SAMPLES=30
# v3.2: 2.0 (trước 1.3 – học nhiễu rồi đảo ngược sau 48h). Đổi cách thoát lệnh cần ≥ LEARN_EXIT_MIN_SAMPLES cặp.
LEARN_MIN_T=2.0
LEARN_EXIT_MIN_SAMPLES=60
LEARN_COOLDOWN_H=48
LEARN_WINDOW_DAYS=21
# v4.0: kiểm soát tỉ lệ phát hiện sai (Benjamini–Hochberg) khi thử ~30 luật + trigger cùng lúc; 0 = tắt
LEARN_FDR_Q=0.10
# Báo cáo tự học mỗi ngày (số liệu, không AI)
DAILY_REVIEW=true
DAILY_REVIEW_HOUR=7

# ============ CÁCH THOÁT LỆNH ("ăn sóng") ============
# auto = bộ tự học chọn (khởi đầu hybrid) | hybrid = chốt 50% ở 2R rồi bám sóng | fixed = TP cố định | trail = bám sóng toàn bộ
EXIT_MODE=auto
TP1_R=1.0
TP1_FRACTION=0.5
TRAIL_ATR_MULT=2.5
TRAIL_TIGHTEN_R=4.0
TRAIL_ATR_MULT_TIGHT=1.5
STALL_HOURS=4
RUNNER_MAX_HOLD_HOURS=24

# Địa chỉ HTTPS công khai của bot (dùng cho Zoom OAuth callback & các trang chính sách)
PUBLIC_URL=
# Email liên hệ hiện trên /privacy, /support (Zoom yêu cầu có kênh liên hệ)
SUPPORT_EMAIL=

# ============ ZOOM TEAM CHAT (tuỳ chọn, ngang hàng Telegram – theo mô hình repo lananh) ============
# Chatbot: nhận lệnh + gửi thông báo tới JID đã ghép đôi. Cần URL HTTPS (Render) – xem README mục 10.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_JID=
ZOOM_SECRET_TOKEN=
ZOOM_ACCOUNT_ID=
# Cơ chế xác thực cũ, chỉ dùng nếu app không có Secret Token
ZOOM_VERIFICATION_TOKEN=
# Tuỳ chọn: email/JID tự được cấp quyền (không cần /zoompair)
ZOOM_ALLOWED_USERS=
# Tuỳ chọn: Incoming Webhook – gửi thông báo vào 1 kênh Zoom (không cần HTTPS, chạy được trên Botkeep)
ZOOM_WEBHOOK_URL=
ZOOM_WEBHOOK_TOKEN=
