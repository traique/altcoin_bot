# ====== BIẾN CHO BOTKEEP – bot v4.2.0 (không AI: kỹ thuật + tin tức, lớp bảo vệ, tự chỉnh cổng lọc) ======
# NÂNG CẤP TỪ v3.x: upload zip đè xong, XOÁ file bot/ai.py cũ nếu còn (File Manager). Còn sót thì trang Phiên bản
# báo "khác bản phát hành" – bot vẫn chạy nhưng nên xoá để mã bản dựng khớp 96d357e.
# Nhập trong panel Botkeep → Environment → khung .env (Saved configuration).
# Biến đã lưu hiện dạng TÊN="__BOTKEEP_KEEP_SECRET_TÊN__": GIỮ NGUYÊN dòng đó để giữ giá trị.
# KHÔNG dán dòng có <...> vào panel – thay <...> bằng giá trị thật, hoặc bỏ dòng đó.
#
# CHỈ CẦN KHAI các biến dưới đây. Mọi thông số giao dịch (MIN_SCORE, TP1_R, rủi ro, ADX…) đã có
# mặc định tốt nhất trong code và tự cập nhật mỗi khi tải zip bản mới → KHÔNG khai trên panel,
# nếu khai thì giá trị trên panel sẽ giữ cố định, không theo bản mới.
# Kiểm tra sau khi restart: log có dòng "Thông số đang dùng: MIN_SCORE=… RISK=…".

# ---------- Chế độ & thông tin riêng ----------
MODE=paper
PAPER_START_BALANCE=10

# ---------- Hồ sơ TEST GẮT (bật 28/10/2026 để thử bản 3.2 với vốn nhỏ) ----------
# 10% vốn mỗi lệnh thay vì 3%; hai lệnh cùng mở tối đa 20%; cầu dao ngày 30%, drawdown 50%.
# Chuỗi 5 lệnh thua liên tiếp sẽ kéo vốn xuống ~40% – chấp nhận khi chạy ảo. Muốn về an toàn: xoá 4 dòng này.
RISK_PER_TRADE=0.10
MAX_TOTAL_RISK=0.20
MAX_DAILY_LOSS=0.30
MAX_DRAWDOWN=0.50
I_UNDERSTAND_THE_RISK=no
INSTANCE_NAME=crypto
TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_URL=https://okx.bot-keep.xyz
SUPPORT_EMAIL=

# ---------- Web dashboard ----------
DASHBOARD_USER=admin
DASHBOARD_PASS=<mật khẩu dashboard>

# ---------- Telegram ----------
TELEGRAM_TOKEN=<token @BotFather>
TELEGRAM_CHAT_ID=<chat id>

# ---------- AI: ĐÃ BỎ từ v4.0 ----------
# Bot không gọi AI nữa – XOÁ trên panel các biến cũ: AI_*, NINEROUTER_*, OPENROUTER_*, CUSTOM_* (để lại cũng không sao, bot bỏ qua).
# Tin tức lấy từ RSS + thông báo sàn + Fear & Greed, miễn phí, KHÔNG cần API key.

# ---------- OKX (chỉ khi chạy thật MODE=live) ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ---------- Zoom Team Chat ----------
ZOOM_CLIENT_ID=<Client ID>
ZOOM_CLIENT_SECRET=<Client Secret>
ZOOM_BOT_JID=<Bot JID>
ZOOM_SECRET_TOKEN=<Secret Token>
# ZOOM_ACCOUNT_ID: để trống/xoá – bot tự lấy từ Zoom (KHÔNG điền "Account No." 10 chữ số ở zoom.us/account)
ZOOM_ACCOUNT_ID=
# Tuỳ chọn: JID nhận thông báo cố định (chỉ khi nút "Gửi thử" trên web vẫn báo lỗi)
ZOOM_TO_JID=

# ---------- Chạy song song Render + Supabase (bỏ qua nếu chỉ chạy Botkeep) ----------
DATABASE_URL=
PEER_URL=

# ---------- TUỲ CHỌN (chỉ thêm khi muốn khác mặc định) ----------
# Mặc định trong code bản này (v4.0): MIN_SCORE=5.0 MIN_ADX=20 HTF_MIN_ADX=18 MAX_EXT_ATR=1.0 MIN_VOL_RATIO=0.7
# BTC_GATE_CHG=0.3 CHASE_1H_PCT=0.5 CLIMAX_VOL=1.5 LATE_TREND_ADX=35 LATE_TREND_PENALTY=0 (v4.2: bỏ trừ điểm) CRYPTO_ONLY=true
# TP1_R=1.0 (tự học chọn lại) RISK_PER_TRADE=0.03 (×0.5–1.5 theo tin tức, co từ lệnh thua thứ 3) MAX_TOTAL_RISK=0.05
# MAX_OPEN_POSITIONS=2 MAX_DAILY_LOSS=0.12 MAX_DRAWDOWN=0.30 LEVERAGE=10 TOP_N_COINS=50 ENTRY_CANDIDATES=3 EXIT_MODE=auto
# NEWS_ENABLED=true NEWS_REFRESH_MIN=10 NEWS_SCORE_MAX=1.5 NEWS_WEIGHT=1.0 NEWS_EXIT_EVENTS=delist,hack,listing
# LEARN_MIN_SAMPLES=30 LEARN_MIN_T=2.0 LEARN_FDR_Q=0.10 LEARN_EXIT_MIN_SAMPLES=60 LEARN_COOLDOWN_H=48
# v4.1: PROTECT_ENABLED=true PROTECT_SIDE_LOSSES=3 PROTECT_SIDE_HOURS=12 PROTECT_SHADOW_MIN=10 PROTECT_SHADOW_SL_SHARE=0.8
# PROTECT_LOCK_HOURS=6 PROTECT_PAIR_LOSS_HOURS=6 PROTECT_PAIR_REPEAT_HOURS=24 PROTECT_MIN_AGE_DAYS=10
# DEFAULT_BLOCKS=setup_range,night_session,afternoon_session,climax_volume,news_delist,news_hack_long,news_listing_short
# LƯU Ý: nếu panel đang khai DEFAULT_BLOCKS / RISK_PER_TRADE / MIN_SCORE… từ bản cũ → XOÁ để dùng mặc định mới
# (đặc biệt DEFAULT_BLOCKS cũ sẽ làm mất 3 luật tin tức chặn sẵn của v4.0).
# Bản 4.0 tự nâng cấp tham số bộ tự học 1 lần khi khởi động: xoá ngưỡng phủ quyết AI, giữ TP1/trọng số đã học, thêm trọng số tin tức.
